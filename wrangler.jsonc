{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "website",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Pages run through the Worker, which fills in the YouTube videos; everything else is served directly.
		"run_worker_first": ["/", "/*/", "/yt/*"]
	}
}
